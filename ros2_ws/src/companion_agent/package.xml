<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>companion_agent</name>
  <version>0.1.0</version>
  <description>Voice/text command router (ROSA integration point).</description>
  <maintainer email="dkstudiosnz@gmail.com">Dan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>companion_interfaces</depend>
  <depend>companion_memory</depend>
  <exec_depend>companion_voice</exec_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
